{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CredentialAndPolicyAdministration",
      "Effect": "Allow",
      "Action": [
        "iam:CreateAccessKey",
        "iam:AttachUserPolicy",
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:iam::123456789012:user/app-deploy"
    },
    {
      "Sid": "ReadDeploymentMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "s3:ListBucket"
      ],
      "Resource": "*"
    }
  ]
}
